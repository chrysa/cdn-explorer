# cdn-explorer backend — environment variables

# Demo mode — serve fixture crawl data without contacting any real CDN.
# Off by default. Shows a "DEMO" banner in the UI while enabled. Never enable in prod.
DEMO_MODE=false

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
ENVIRONMENT=development
RELEASE=cdn-explorer@0.1.0

# chrysa:opencode-env:start · managed by distribute-standards.sh · DO NOT EDIT
# --- opencode LLM providers ---
OLLAMA_URL=http://127.0.0.1:11434   # local default, offline-first (opencode default model)
ANTHROPIC_API_KEY=                  # opt-in: Claude (cloud)
OPENAI_API_KEY=                     # opt-in: ChatGPT (cloud)
# chrysa:opencode-env:end
